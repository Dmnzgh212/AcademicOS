{
 "manifest_version":3,
 "name":"LifeHub 本地浏览器连接",
 "version":"0.3.1",
 "description":"绑定明确的页面，采集并归档正文、轮询变化、显示绑定标签的监控画面。",
 "minimum_chrome_version":"120",
 "permissions":["activeTab","scripting","storage","alarms","debugger"],
 "optional_host_permissions":["https://*/*","http://*/*"],
 "action":{"default_popup":"popup.html"},
 "background":{"service_worker":"worker.js","type":"module"},
 "content_scripts":[{"matches":["https://lifehub-workstation.zhihangz212.chatgpt.site/*"],"js":["site.js"],"run_at":"document_idle"}]
}
